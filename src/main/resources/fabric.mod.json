	"authors": [
		"DarkJune", "Acherkan"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/DarkJune0122/Fortune-on-Netherite-fabric-fork"
	},
	"license": "CC0-1.0",
	"icon": "assets/fortuneonnetherite/icon.png",
	"environment": "*",
