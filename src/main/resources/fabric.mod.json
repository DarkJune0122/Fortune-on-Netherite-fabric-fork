          "net.fortuneonnetherite.FortuneOnNetheriteFabric"
		],
		"fabric-datagen": [
			"net.fortuneonnetherite.FortuneOnNetheriteFabricDataGenerator"
		]
	},
	"mixins": [
		"fon.mixins.json"
	],
	"depends": {
